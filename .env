
# ▃▃▃▃▃▃▃▃▃▃▃▃ Sample Storefront ▃▃▃▃▃▃▃▃▃▃▃▃
# Fresh Bazaar — Selldone shop #88 (testshop2.myselldone.com)

VITE_APP_SAMPLE_SHOP_NAME=testshop2

# shop | blog | community | map | <landing page id>. The 3D market renders for "shop" and landing homes.
VITE_APP_SAMPLE_SHOP_CUSTOM_HOME=shop

VITE_APP_SAMPLE_DEFAULT_CURRENCY=USD
VITE_APP_SAMPLE_DEFAULT_COUNTRY=US
VITE_APP_SAMPLE_DEFAULT_LANGUAGE=en


VITE_APP_SAMPLE_THEME_COLOR_LIGHT="#1a8f9a"
VITE_APP_SAMPLE_THEME_COLOR_DARK="#1b3f8f"
VITE_APP_SAMPLE_THEME_COLOR_DEEP_DARK="#2b1d12"
VITE_APP_SAMPLE_THEME_COLOR_INFO="#d99a1e"

# ▃▃▃▃▃▃▃▃▃▃▃▃ Dev Server ▃▃▃▃▃▃▃▃▃▃▃▃

VITE_APP_DEV_SERVER_HOST=
VITE_APP_DEV_SERVER_PORT=
VITE_APP_DEV_SERVER_HTTPS=FALSE
